# Compose project and image settings
COMPOSE_PROJECT_NAME=cftp-web-dev
IMAGE_REGISTRY=localhost
IMAGE_TAG=v1

# Must match the container targets configured in cftptest's global Caddy.
# Development: cftp-dev; production: cftp-prod.
PORTAL_CONTAINER_PREFIX=cftp-dev

# The frontend network is created by this Compose project.
WEB_NETWORK_NAME=cftp-web-dev-net

# Shared network created by cftptest/deployment/docker-compose/gateway.
GATEWAY_NETWORK_NAME=cftp-gateway-net

# The backend network must already exist. With cftptest's Compose project
# name set to cftp-dev, the default is cftp-dev_cftp-net.
BACKEND_NETWORK_NAME=cftp-dev_cftp-net

# cfgserver and downstream services are reached on BACKEND_NETWORK_NAME.
CFGSERVER_ADDR=cfgserver:50051
CASDOOR_ENDPOINT=casdoor:8000

# Public URLs used by browser redirects, CORS and exam callbacks.
CASDOOR_PUBLIC_ENDPOINT=https://cftpcasdoor.example.com
CORS_ALLOWED_ORIGINS=https://cftpcand.example.com,https://cftpadmin.example.com
EXAM_CALLBACK_BASE_URL=https://cftpcand.example.com
PAYMENT_RETURN_ALLOWED_ORIGINS=https://cftpcand.example.com

# Safe to leave empty when Stripe is not enabled.
STRIPE_PUBLISHABLE_KEY=

# Optional explicit gRPC addresses. Empty values use the service-name
# defaults in cftpweb (for example gmall:50051).
MALL_GRPC_ADDR=gmall:50051
LMS_GRPC_ADDR=glms:50051
GCC_GRPC_ADDR=gcc:50051
GPROG_GRPC_ADDR=gprog:50051
GMSG_GRPC_ADDR=gmsg:50051
GCREDS_GRPC_ADDR=gcreds:50051
GEXAM_GRPC_ADDR=gexam:50051
GMID_GRPC_ADDR=gmid:50051
GPAY_GRPC_ADDR=gpay:50051
GMBR_GRPC_ADDR=gmbr:50051
GMAIL_GRPC_ADDR=gmail:50051
GAUDIT_GRPC_ADDR=gaudit:50051

# Leave TLS_DIR empty for plaintext gRPC on the private Docker network.
# When mTLS is enabled, set TLS_DIR=/etc/tls and add a Compose override that
# mounts the CA/client certificate directory into both BFF containers.
TLS_DIR=
