COMPOSE_PROJECT_NAME=cftp-web-gateway
WEB_NETWORK_NAME=cftp-web-net

# Public DNS records must point to this host before requesting certificates.
CANDIDATE_PORTAL_DOMAIN=cftpcand.example.com
ADMIN_PORTAL_DOMAIN=cftpadmin.example.com
ACME_EMAIL=admin@example.com

# Override only when ports 80/443 are already occupied.
HTTP_PORT=80
HTTPS_PORT=443
